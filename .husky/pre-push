#!/bin/sh

UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || true)
if [ -n "$UPSTREAM" ]; then
  RANGE="$UPSTREAM..HEAD"
else
  ROOT=$(git rev-list --max-parents=0 HEAD | tail -1)
  RANGE="$ROOT..HEAD"
fi

node scripts/guard_stage_deploy_policy.mjs --committed "$RANGE"
if [ $? -ne 0 ]; then
  exit 1
fi
