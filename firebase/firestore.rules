rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════
    // 기본 인증 헬퍼
    // ══════════════════════════════════════════════════════════════

    // 1차: Firebase 로그인 + @mysc.co.kr 이메일 도메인 확인
    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@mysc\\.co\\.kr$');
    }

    // ══════════════════════════════════════════════════════════════
    // 테넌트 격리 헬퍼 (orgs/{orgId}/members/{uid} 멤버십 확인)
    // ══════════════════════════════════════════════════════════════

    // 요청 사용자가 해당 orgId의 멤버인지 확인
    function isMember(orgId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid));
    }

    // 멤버 문서에서 역할 조회
    function getMemberRole(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.role;
    }

    // ══════════════════════════════════════════════════════════════
    // 역할 기반 접근 제어 헬퍼
    // ══════════════════════════════════════════════════════════════

    // 읽기: org 멤버면 허용 (viewer 포함)
    function canRead(orgId) {
      return isMember(orgId);
    }

    // 쓰기: viewer 제외 모든 역할 허용 (admin, finance, pm)
    function canWrite(orgId) {
      return isMember(orgId)
        && getMemberRole(orgId) in ['admin', 'finance', 'pm'];
    }

    // 어드민 전용
    function isAdmin(orgId) {
      return isMember(orgId)
        && getMemberRole(orgId) in ['admin'];
    }

    // 감사/재무 접근 (audit_logs 읽기용)
    function canReadAuditLogs(orgId) {
      return isMember(orgId)
        && getMemberRole(orgId) in ['admin', 'finance'];
    }

    // BFF 전용 PII 컬렉션: 클라이언트 SDK 직접 접근 금지.
    // BFF(Admin SDK)는 rules를 우회하므로 검증, 감사, idempotency를 서버에서 강제한다.
    function isBffOnlyCollection(collection) {
      return collection in ['contacts', 'business_card_imports', 'contact_events'];
    }

    // 일반 org 멤버 catchall에서 제외할 컬렉션.
    // 각 컬렉션의 상단 override 규칙만 적용되도록 막는다.
    function isCatchallExcludedCollection(collection) {
      return isBffOnlyCollection(collection)
        || collection in ['projectRequestDrafts']
        || collection in ['privateEditDrafts']
        || collection in ['cashflowEditLocks']
        || collection in ['editLeases']
        || collection in ['idempotency_keys'];
    }

    function isCatchallExcludedPath(collection, document) {
      return isCatchallExcludedCollection(collection)
        || (collection == 'settings' && document == 'project-departments');
    }

    // ══════════════════════════════════════════════════════════════
    // 최상위 tenants는 클라이언트 목록 쿼리 권한을 안정적으로 검증할 수 없으므로 사용하지 않는다.
    // 조직DB는 orgs/{orgId}/tenant_registry에서 조직 admin 권한으로 관리한다.
    // ══════════════════════════════════════════════════════════════

    match /tenants/{tenantId} {
      allow read, write: if false;
    }

    // ══════════════════════════════════════════════════════════════
    // orgs/{orgId}/** 규칙
    // 특정 컬렉션 override → 일반 규칙 순서로 적용
    // ══════════════════════════════════════════════════════════════

    // ── 구성원(members) ──
    // 테넌트 격리의 핵심: 이 문서가 존재해야 isMember() 통과
    match /orgs/{orgId}/members/{memberId} {
      allow read: if canRead(orgId);

      // 최초 로그인 자기 등록: 본인 UID로만, 기본 역할 pm 고정
      // (auth-store.tsx의 upsertMemberFromFirebase 지원)
      // 다른 역할 부여는 admin이 /users 페이지에서 변경
      allow create: if isSignedIn()
        && memberId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'pm';

      // 자기 문서 업데이트: lastLoginAt/avatarUrl 등 갱신 허용, role 변경 불가
      allow update: if isSignedIn()
        && memberId == request.auth.uid
        && request.resource.data.role == resource.data.role;

      // Admin: 역할 변경·삭제·타인 문서 수정 포함 모든 쓰기
      allow write: if isAdmin(orgId);
    }

    // ── 조직DB: 현재 조직 admin만 조직 registry를 관리 ──
    match /orgs/{orgId}/tenant_registry/{tenantId} {
      allow read: if isAdmin(orgId);

      allow create: if isAdmin(orgId)
        && request.resource.data.id == tenantId
        && request.resource.data.adminOrgId == orgId;

      allow update: if isAdmin(orgId)
        && request.resource.data.adminOrgId == resource.data.adminOrgId;

      allow delete: if isAdmin(orgId)
        && resource.data.protected != true;
    }

    // ── 감사 로그: 클라이언트 쓰기 금지, 특정 역할만 읽기 ──
    // 생성은 BFF 서버(Admin SDK)에서만 수행 → 규칙 우회됨
    match /orgs/{orgId}/audit_logs/{logId} {
      allow read: if canReadAuditLogs(orgId);
      allow write: if false;
    }

    // ── 알림: 본인 알림만 읽기/읽음 처리 ──
    // 생성은 BFF 서버에서만 수행
    // recipientId == request.auth.uid 조건은 쿼리 필터와 함께 동작
    match /orgs/{orgId}/notifications/{notifId} {
      allow read: if canRead(orgId) && resource.data.recipientId == request.auth.uid;
      allow update: if canRead(orgId) && resource.data.recipientId == request.auth.uid;
      allow create, delete: if false;
    }

    // ── 명함 DB/연락처: BFF API로만 접근 ──
    match /orgs/{orgId}/contacts/{contactId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/business_card_imports/{importId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/contact_events/{eventId} {
      allow read, write: if false;
    }

    // ── 편집 lease: BFF API로만 접근 ──
    match /orgs/{orgId}/editLeases/{leaseId} {
      allow read, write: if false;
    }

    // ── 멱등 replay 결과: BFF API로만 접근 ──
    match /orgs/{orgId}/idempotency_keys/{keyId} {
      allow read, write: if false;
    }

    // ── 프로젝트 변경 알림: admin/finance만 쓰기 ──
    match /orgs/{orgId}/project_change_alerts/{alertId} {
      allow read: if canRead(orgId);
      allow write: if isMember(orgId)
        && getMemberRole(orgId) in ['admin', 'finance'];
    }

    // ── 관리자 설정: 프로젝트 선택값 ──
    match /orgs/{orgId}/settings/project-departments {
      allow read: if canRead(orgId);
      allow write: if isAdmin(orgId);
    }

    // ── 프로젝트 등록/수정 임시저장: BFF API로만 접근 ──
    match /orgs/{orgId}/projectRequestDrafts/{draftId} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/privateEditDrafts/{draftId} {
      allow read, write: if false;
    }

    // ── 구형 캐시플로 직접 잠금: BFF lease를 우회하지 못하도록 차단 ──
    match /orgs/{orgId}/cashflowEditLocks/{lockId} {
      allow read, write: if false;
    }

    // ── 일반 규칙: 나머지 모든 컬렉션 ──
    // (projects, ledgers, transactions, evidences, comments, 등)
    match /orgs/{orgId}/{collection}/{document=**} {
      allow read: if !isCatchallExcludedPath(collection, document) && canRead(orgId);
      allow write: if !isCatchallExcludedPath(collection, document) && canWrite(orgId);
    }
  }
}
