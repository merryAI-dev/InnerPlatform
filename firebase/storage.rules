rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isMyscSignedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@mysc\\.co\\.kr$');
    }

    // Private 원본 파일은 BFF API에서만 조회한다.
    // Storage rules는 특정 deny가 broad allow를 이기지 못하므로 아래 orgs catch-all에서도 제외한다.
    match /orgs/{orgId}/business-cards/{allPaths=**} {
      allow read, write: if false;
    }

    match /orgs/{orgId}/project-registration-drafts/{allPaths=**} {
      allow read, write: if false;
    }

    // ── 테넌트 스코프 스토리지 경로: orgs/{orgId}/** ──
    // Firestore와 달리 Storage에서는 Firestore 멤버십 조회 불가.
    // 최소 보안 레이어: Firebase 로그인 + @mysc.co.kr 이메일 도메인 확인.
    match /orgs/{orgId}/{collection}/{allPaths=**} {
      allow read: if collection != 'business-cards' && collection != 'project-registration-drafts' && isMyscSignedIn();
      allow write: if collection != 'business-cards' && collection != 'project-registration-drafts' && isMyscSignedIn();
    }

    // 그 외 경로: 모두 거부
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
