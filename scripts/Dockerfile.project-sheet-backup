FROM node:24-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

COPY server ./server
COPY scripts/export_project_sheet_backups.mjs ./scripts/export_project_sheet_backups.mjs

ENV NODE_ENV=production
ENV BACKUP_TENANT_ID=mysc

USER node

CMD ["node", "scripts/export_project_sheet_backups.mjs"]
